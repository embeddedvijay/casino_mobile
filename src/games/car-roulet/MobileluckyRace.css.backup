*{
  box-sizing:border-box;
  -webkit-tap-highlight-color:transparent;
}

html,
body,
#root{
  margin:0;
  width:100%;
  min-height:100%;
  overflow-x:hidden;
  overflow-y:auto;
}

body{
  background:#020006;
  font-family:Arial,Helvetica,sans-serif;
  -webkit-text-size-adjust:100%;
  text-size-adjust:100%;
  overscroll-behavior:auto;
}

button{
  font:inherit;
  -webkit-appearance:none;
  appearance:none;
  border:0;
  outline:0;
  background:transparent;
}

img{
  display:block;
  max-width:100%;
}

.mlr-page{
  position:relative;
  min-height:100dvh;
  overflow-x:hidden;
  overflow-y:auto;
  color:#fff;
  padding:10px 10px 18px;
  background:#040007;
}

.mlr-page::before{
  content:"";
  position:fixed;
  inset:0;
  background:radial-gradient(circle at 50% 26%,rgba(255,0,255,.24),transparent 32%),radial-gradient(circle at 50% 70%,rgba(255,190,0,.10),transparent 30%),linear-gradient(180deg,#07000f,#020006 70%);
  z-index:0;
  pointer-events:none;
}

.mlr-page::after{
  content:"";
  position:fixed;
  inset:0;
  background-image:url("/assets/car-roulette-bg.png");
  background-position:center;
  background-size:cover;
  background-repeat:no-repeat;
  opacity:.12;
  filter:saturate(1.35);
  z-index:1;
  pointer-events:none;
}

.mlr-page > *{
  position:relative;
  z-index:2;
}

.mlr-header{
  height:72px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:10px 14px;
  border:1.8px solid #ffe14a;
  border-radius:22px;
  background:linear-gradient(180deg,rgba(12,9,20,.98),rgba(2,1,7,.96));
  box-shadow:0 0 22px rgba(255,215,0,.24),inset 0 0 18px rgba(255,255,255,.04);
}

.mlr-header-brand{
  display:flex;
  align-items:center;
  gap:8px;
  color:#ffd943;
  font-size:31px;
  font-weight:1000;
  text-shadow:0 0 16px rgba(255,215,0,.72);
  white-space:nowrap;
}

.mlr-header-brand span{
  font-size:35px;
  line-height:1;
}

.mlr-user-pill{
  height:50px;
  display:flex;
  align-items:center;
  gap:9px;
  padding:6px 12px 6px 6px;
  border:1.4px solid rgba(255,215,0,.72);
  border-radius:999px;
  background:rgba(0,0,0,.50);
}

.mlr-user-avatar{
  width:38px;
  height:38px;
  display:grid;
  place-items:center;
  border-radius:50%;
  background:linear-gradient(180deg,#ffe56a,#b56e00);
  color:#111;
  font-size:22px;
  flex:0 0 auto;
}

.mlr-user-pill strong{
  display:block;
  font-size:14px;
  line-height:1;
  white-space:nowrap;
}

.mlr-user-pill small{
  display:block;
  margin-top:5px;
  color:#30ff62;
  font-size:13px;
  font-weight:1000;
  white-space:nowrap;
}

.mlr-results{
  height:72px;
  margin:10px 0 12px;
  display:flex;
  align-items:center;
  gap:10px;
  border:1.8px solid rgba(230,0,255,.95);
  border-radius:20px;
  padding:8px 10px;
  background:linear-gradient(180deg,rgba(19,5,27,.98),rgba(5,1,9,.96));
  box-shadow:0 0 18px rgba(255,0,255,.22),inset 0 0 16px rgba(255,255,255,.04);
}

.mlr-results b{
  min-width:92px;
  height:52px;
  display:grid;
  place-items:center;
  border-radius:16px;
  background:rgba(97,0,113,.62);
  color:#fff;
  font-size:16px;
  font-weight:1000;
  white-space:nowrap;
}

.mlr-result-list{
  min-width:0;
  display:flex;
  align-items:center;
  gap:10px;
  overflow:hidden;
}

.mlr-result-logo{
  width:50px;
  height:50px;
  display:grid;
  place-items:center;
  border-radius:50%;
  overflow:hidden;
  background:#070707;
  border:2px solid #eee;
  flex:0 0 auto;
  box-shadow:0 0 10px rgba(255,255,255,.45);
}

.mlr-result-logo img{
  width:100%;
  height:100%;
  object-fit:cover;
  border-radius:50%;
  clip-path:circle(50% at 50% 50%);
}

.mlr-empty{
  font-size:12px;
  color:#bbb;
  align-self:center;
}

.mlr-board{
  position:relative;
  width:100%;
  height:665px;
  overflow:hidden;
  border-radius:0;
  border:0;
  background-image:url("/new-logos/mobile-view-bg-table.png");
  background-position:center top;
  background-size:100% 100%;
  background-repeat:no-repeat;
  box-shadow:none;
}

.mlr-center-dashboard{
  position:absolute;
  left:50%;
  top:255px;
  width:75%;
  transform:translateX(-50%);
  z-index:12;
  pointer-events:none;
}

.mlr-dashboard-panel{
  position:relative;
  min-height:136px;
  border-radius:24px;
  background:transparent;
  border:0;
  box-shadow:none;
  padding:18px 10px 10px;
}

.mlr-round-id{
  position:absolute;
  left:50%;
  top:-18px;
  transform:translateX(-50%);
  min-width:170px;
  padding:4px 10px;
  border-radius:999px;
  background:rgba(5,0,12,.92);
  color:#e8d7f1;
  text-align:center;
  font-size:11px;
  font-weight:1000;
  white-space:nowrap;
}

.mlr-dash-main{
  height:54px;
  display:grid;
  grid-template-columns:1fr 1px 1fr;
  border-radius:14px;
  overflow:hidden;
  background:transparent;
  border:0;
}

.mlr-dash-box{
  display:flex;
  flex-direction:column;
  justify-content:center;
  padding:0 12px;
}

.mlr-dash-box small{
  color:#f4edf8;
  font-size:12px;
  font-weight:1000;
}

.mlr-dash-box b{
  margin-top:4px;
  color:#ffe829;
  font-size:19px;
  line-height:1;
  font-weight:1000;
  white-space:nowrap;
}

.mlr-dash-box.right{
  text-align:center;
}

.mlr-dash-box.right b{
  color:#22ff6a;
}

.mlr-dash-divider{
  background:rgba(255,255,255,.18);
}

.mlr-progress-wrap{
  position:relative;
  height:20px;
  margin:10px 8px 0;
  border-radius:999px;
  overflow:hidden;
  background:transparent;
  border:0;
  box-shadow:none;
}

.mlr-progress-fill{
  height:100%;
  border-radius:999px;
  background:repeating-linear-gradient(135deg,#d717ff 0 10px,#ff3fbb 10px 20px,#ff7a1a 20px 30px,#ffe100 30px 40px);
  box-shadow:0 0 13px rgba(255,0,255,.88);
  transition:width .45s linear;
  animation:mlrProgressGlow .8s linear infinite;
}

.mlr-progress-car{
  position:absolute;
  top:-10px;
  transform:translateX(-50%);
  font-size:21px;
  transition:left .45s linear;
  filter:drop-shadow(0 0 8px #00eaff);
}

.mlr-finish{
  position:absolute;
  right:1px;
  top:-9px;
  font-size:25px;
}

.mlr-time-left{
  margin-top:8px;
  display:flex;
  align-items:flex-end;
  justify-content:center;
  gap:5px;
  color:#eee;
}

.mlr-time-left span{
  font-size:12px;
  font-weight:900;
}

.mlr-time-left b{
  color:#ffe829;
  font-size:27px;
  line-height:.9;
  font-weight:1000;
}

.mlr-time-left small{
  font-size:11px;
  font-weight:900;
}

.mlr-track-area{
  position:absolute;
  left:0;
  right:0;
  top:8px;
  height:470px;
  z-index:20;
  overflow:hidden;
  pointer-events:none;
}

.mlr-track-logo{
  position:absolute;
  width:41px;
  height:41px;
  display:grid;
  place-items:center;
  border-radius:50%;
  overflow:hidden;
  background:#030303;
  border:2px solid rgba(255,255,255,.96);
  transform:translate(-50%,-50%);
  box-shadow:0 4px 8px rgba(0,0,0,.85),0 0 7px rgba(255,255,255,.32);
  transition:left .08s linear,top .08s linear,transform .08s linear;
}

.mlr-track-logo img{
  width:100%;
  height:100%;
  object-fit:cover;
  border-radius:50%;
  clip-path:circle(50% at 50% 50%);
}

.mlr-track-logo.active{
  border-color:#ff2dff;
  transform:translate(-50%,-50%) scale(1.12);
  box-shadow:0 0 18px #ff2dff,0 0 35px rgba(255,0,255,.88);
}

.mlr-moving-marker{
  position:absolute;
  width:60px;
  height:60px;
  display:grid;
  place-items:center;
  border-radius:50%;
  overflow:hidden;
  background:#04130a;
  border:5px solid #00ff51;
  transform:translate(-50%,-50%);
  box-shadow:0 0 22px #00ff51,0 0 48px rgba(0,255,81,.80);
  transition:left .08s linear,top .08s linear;
  z-index:50;
  pointer-events:none;
}

.mlr-moving-marker img{
  width:50px;
  height:50px;
  object-fit:cover;
  border-radius:50%;
  clip-path:circle(50% at 50% 50%);
}

.mlr-moving-marker.stop-effect{
  animation:mlrStopBounce 1.2s ease-out both;
}


.mlr-bet-cell span,
.mlr-rupee{
  position:absolute;
  left:0;
  right:0;
  bottom:7px;
  color:#ffe829;
  text-align:center;
  font-size:16px;
  line-height:1;
  font-weight:1000;
  text-shadow:0 0 8px rgba(255,216,0,.85),0 2px 5px #000;
}

.mlr-winner-popup{
  position:absolute;
  z-index:80;
  left:50%;
  top:43%;
  width:150px;
  height:130px;
  transform:translate(-50%,-50%);
  display:grid;
  place-items:center;
  border-radius:24px;
  border:3px solid #00ff51;
  background:rgba(0,0,0,.9);
  box-shadow:0 0 35px rgba(0,255,81,.8);
}

.mlr-winner-popup b{
  color:#f6ef00;
  font-size:18px;
}

.mlr-winner-popup img{
  width:72px;
  height:72px;
  object-fit:cover;
  border-radius:50%;
}

.mlr-coins{
  position:relative;
  z-index:2;
  width:100%;
  height:72px;
  margin-top:12px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:6px;
  overflow:hidden;
  padding:7px 8px;
  border-radius:18px;
  background:rgba(6,0,12,.96);
  border:1px solid rgba(255,199,45,.45);
}

.mlr-coins button{
  flex:0 0 49px;
  width:49px;
  height:49px;
  border-radius:50%;
  border:4px dashed rgba(255,255,255,.88);
  color:#fff;
  font-size:13px;
  font-weight:1000;
  text-shadow:0 2px 4px #000;
  background:radial-gradient(circle,#fff7d4,#d87800 48%,#5a2a00);
  box-shadow:inset 0 0 10px rgba(255,255,255,.72),0 6px 10px rgba(0,0,0,.72);
}

.mlr-coins button:nth-child(1){
  background:radial-gradient(circle,#e4fff0,#15a72e 48%,#045413);
}

.mlr-coins button:nth-child(2){
  background:radial-gradient(circle,#e9f7ff,#1477cf 48%,#063462);
}

.mlr-coins button:nth-child(3){
  background:radial-gradient(circle,#fff4ff,#8b24d6 48%,#3d005f);
}

.mlr-coins button:nth-child(4){
  background:radial-gradient(circle,#fff7d4,#d87800 48%,#5a2a00);
}

.mlr-coins button:nth-child(5){
  background:radial-gradient(circle,#fff1e8,#c90c0c 48%,#5a0000);
}

.mlr-coins button.active{
  transform:translateY(-4px) scale(1.05);
  box-shadow:0 0 18px rgba(255,240,0,.95);
}

.mlr-coins .clear{
  flex:0 0 76px;
  width:76px;
  height:50px;
  border-radius:18px;
  border:2px solid #ff2859;
  background:linear-gradient(180deg,rgba(210,35,47,.96),rgba(66,5,16,.98));
  font-size:16px;
}

.mlr-win{
  position:fixed;
  inset:0;
  z-index:100;
  display:grid;
  place-items:center;
  background:radial-gradient(circle,rgba(255,185,0,.28),rgba(0,0,0,.62) 55%,rgba(0,0,0,.86));
  pointer-events:none;
}

.mlr-win-card{
  width:310px;
  min-height:330px;
  text-align:center;
  border-radius:30px;
  border:3px solid #ffd700;
  background:linear-gradient(180deg,rgba(69,23,0,.96),rgba(5,5,8,.96));
  box-shadow:0 0 34px #ffd700;
  padding:22px;
  animation:winPulse .8s ease-in-out infinite alternate;
}

.mlr-win-card h1{
  margin:0;
  color:#ffd86b;
  font-size:46px;
}

.mlr-win-card img{
  width:120px;
  height:120px;
  object-fit:cover;
  border-radius:50%;
  margin:16px auto;
}

.mlr-win-card h2{
  margin:0;
  color:white;
  font-size:26px;
}

.mlr-win-card p{
  color:#ffe36a;
  font-size:22px;
  font-weight:1000;
}

@keyframes mlrProgressGlow{
  from{
    filter:hue-rotate(0deg);
  }
  to{
    filter:hue-rotate(25deg);
  }
}

@keyframes winPulse{
  from{
    transform:scale(1);
  }
  to{
    transform:scale(1.04);
  }
}

@keyframes mlrStopBounce{
  0%{
    transform:translate(-50%,-50%) scale(1);
  }
  25%{
    transform:translate(-50%,-50%) scale(1.32);
  }
  45%{
    transform:translate(-50%,-50%) scale(.92);
  }
  65%{
    transform:translate(-50%,-50%) scale(1.16);
  }
  100%{
    transform:translate(-50%,-50%) scale(1.08);
    box-shadow:0 0 32px #fff000,0 0 70px #00ff51;
  }
}

@media(max-width:390px){
  .mlr-page{
    padding:8px 8px 14px;
  }

  .mlr-header{
    height:66px;
    padding:8px 10px;
  }

  .mlr-header-brand{
    font-size:27px;
  }

  .mlr-header-brand span{
    font-size:30px;
  }

  .mlr-user-pill{
    transform:scale(.88);
    transform-origin:right center;
  }

  .mlr-results{
    height:68px;
  }

  .mlr-results b{
    min-width:80px;
    font-size:14px;
  }

  .mlr-result-logo{
    width:45px;
    height:45px;
  }

  .mlr-board{
    height:620px;
  }

  .mlr-center-dashboard{
    top:238px;
    width:76%;
  }

  .mlr-dashboard-panel{
    min-height:126px;
    padding-top:18px;
  }

  .mlr-dash-main{
    height:52px;
  }

  .mlr-dash-box small{
    font-size:11px;
  }

  .mlr-dash-box b{
    font-size:18px;
  }

  .mlr-progress-wrap{
    height:19px;
    margin-top:9px;
  }

  .mlr-time-left b{
    font-size:26px;
  }

  .mlr-track-area{
    top:8px;
    height:450px;
  }

  .mlr-track-logo{
    width:36px;
    height:36px;
  }

  .mlr-moving-marker{
    width:58px;
    height:58px;
  }

  .mlr-moving-marker img{
    width:48px;
    height:48px;
  }

  .mlr-coins{
    height:68px;
    gap:5px;
    padding:7px 7px;
  }

  .mlr-coins button{
    flex-basis:46px;
    width:46px;
    height:46px;
    font-size:12px;
  }

  .mlr-coins .clear{
    flex-basis:70px;
    width:70px;
    height:48px;
    font-size:15px;
  }
}

/* Keep Android status icons outside the game header on every phone. */
.mlr-page{
  padding-top:max(24px,env(safe-area-inset-top,0px)) !important;
}

/* Final alignment and authentic race-game surface. */
.mlr-page{
  width:100%;
  max-width:460px;
  margin:0 auto;
  padding-left:8px!important;
  padding-right:8px!important;
  padding-bottom:88px!important;
  background:linear-gradient(180deg,#090b10,#030407 72%)!important;
}
.mlr-page::before{
  background:radial-gradient(circle at 50% 24%,#38204466,transparent 34%),linear-gradient(180deg,#0b0e14,#030406 75%);
}
.mlr-page::after{opacity:.055;filter:saturate(.7)}
.mlr-header{
  width:100%;
  height:56px;
  padding:6px 8px 6px 11px;
  border:1px solid #ffffff1b;
  border-radius:13px;
  background:#0c0f15f5;
  box-shadow:0 8px 22px #0008;
}
.mlr-header-brand{gap:6px;font-size:20px;color:#f0c94d;text-shadow:0 0 12px #c998294d}
.mlr-header-brand span{font-size:23px}
.mlr-account{min-width:0;display:grid;grid-template-columns:auto 34px;grid-template-rows:27px 12px;align-items:center;column-gap:5px}
.mlr-balance{height:27px;min-width:75px;padding:4px 7px;display:flex;flex-direction:column;justify-content:center;border:1px solid #ffffff17;border-radius:8px;background:#171b22}
.mlr-balance small{color:#65707f;font-size:6px;line-height:1}.mlr-balance b{margin-top:3px;color:#fff;font-size:10px;line-height:1}
.mlr-account>.uml-menu-btn,.mlr-account>[class*="menu"]{grid-column:2;grid-row:1;width:30px;height:30px}
.mlr-user{grid-column:1/3;grid-row:2;max-width:115px;justify-self:end;overflow:hidden;color:#87909d;font-size:7px;letter-spacing:.6px;text-overflow:ellipsis;white-space:nowrap}
.mlr-results{
  width:100%;
  height:51px;
  margin:7px 0!important;
  padding:5px 7px;
  gap:6px;
  overflow:hidden;
  border:1px solid #ffffff14;
  border-radius:10px!important;
  background:#0c1016;
  box-shadow:none;
}
.mlr-results>b{min-width:40px;width:40px;height:30px;padding:0;background:transparent;color:#687382;font-size:7px;letter-spacing:.8px}
.mlr-result-list{width:calc(100% - 46px);gap:6px;overflow:hidden}
.mlr-result-logo{width:36px;height:36px;flex-basis:36px;border:1px solid #59616d;box-shadow:none}
.mlr-board{
  width:100%!important;
  max-width:430px;
  aspect-ratio:400/640;
  border:1px solid #ffffff12!important;
  border-radius:18px!important;
  background-color:#06080d;
  box-shadow:0 14px 35px #0009!important;
}
.mlr-track-logo{border-color:#737986!important;box-shadow:0 3px 7px #000b!important}
.mlr-track-logo.active{border-color:#35e37d!important;transform:translate(-50%,-50%) scale(1.13);box-shadow:0 0 12px #20d86c,0 0 22px #20d86c66!important}
.mlr-moving-marker{border-color:#f0c949;box-shadow:0 0 15px #e9b52d,0 0 28px #e9b52d66}
.mlr-center-dashboard{top:38%!important;width:69%!important}
.mlr-round-id{top:-3.7cqw!important;min-width:36cqw!important;padding:.7cqw 2cqw!important;background:#080b10e8;color:#858e9b;font-size:2.25cqw!important;letter-spacing:.35px}
.mlr-dashboard-panel{height:30cqw!important;padding:3.8cqw 2cqw 2cqw!important}
.mlr-dash-main{height:11cqw!important}.mlr-dash-box{padding:0 2cqw!important}.mlr-dash-box small{color:#858e9b;font-size:2.4cqw!important}.mlr-dash-box b{font-size:3.8cqw!important}.mlr-dash-box.right b{color:#32df7a}
.mlr-progress-wrap{height:3.7cqw!important;margin:1.7cqw 1.5cqw 0!important;border:1px solid #ffffff1a!important;background:#111720!important}
.mlr-progress-fill{background:repeating-linear-gradient(135deg,#e12a51 0 9px,#e12a51 9px 18px,#d9ad35 18px 27px,#d9ad35 27px 36px);box-shadow:0 0 8px #d63d5866;animation:none}
.mlr-progress-car{top:-2.6cqw!important;font-size:4.8cqw!important}.mlr-finish{top:-2.4cqw!important;font-size:5.5cqw!important}
.mlr-time-left{display:flex!important;margin-top:1.4cqw;gap:3px}.mlr-time-left span,.mlr-time-left small{color:#737d89;font-size:2cqw}.mlr-time-left b{color:#f0cb51;font-size:4cqw}
.mlr-betting-grid{left:10px;right:10px;bottom:9px;height:140px;border:1px solid #ffffff1b;border-radius:13px;background:#090c12e8;box-shadow:0 -8px 28px #0008}
.mlr-bet-cell{border-color:#ffffff12;background:linear-gradient(180deg,#11151c,#090c11)}.mlr-bet-cell:active{background:#1a2029;transform:scale(.96)}
.mlr-bet-logo{top:7px;width:32px;height:32px}.mlr-bet-cell span,.mlr-rupee{bottom:8px;color:#d8b843;font-size:11px;text-shadow:none}
.mlr-winner-popup{top:42%;width:132px;height:105px;border:1px solid #e5be46;border-radius:13px;background:#080b10ed;box-shadow:0 0 22px #d7aa3a66;animation:mlrWinnerIn .2s ease-out}.mlr-winner-popup small{color:#7f8996;font-size:6px;letter-spacing:1px}.mlr-winner-popup img{width:49px;height:49px}.mlr-winner-popup b{color:#e7c44e;font-size:10px}
.mlr-coins{
  position:fixed;
  left:50%;
  bottom:8px;
  z-index:90;
  transform:translateX(-50%);
  width:min(calc(100% - 16px),444px);
  height:68px;
  margin:0;
  padding:7px;
  gap:6px;
  border:1px solid #ffffff1a;
  border-radius:14px;
  background:#0b0e14f4;
  box-shadow:0 -10px 26px #000b;
}
.mlr-coins button{flex:0 1 48px;width:48px;height:48px;font-size:10px;border-width:3px;box-shadow:inset 0 0 8px #ffffff66}.mlr-coins button.active{transform:translateY(-4px) scale(1.06);box-shadow:0 4px 15px #e9c34f99,inset 0 0 9px #fff8}.mlr-coins .clear{flex:0 1 65px;width:65px;height:42px;border:1px solid #d4475d;border-radius:9px;background:#8e1730;font-size:10px}
@keyframes mlrWinnerIn{from{opacity:0;transform:translate(-50%,-50%) scale(.75)}to{opacity:1;transform:translate(-50%,-50%) scale(1)}}
@media(max-width:370px){.mlr-header-brand{font-size:17px}.mlr-header-brand span{font-size:20px}.mlr-balance{min-width:65px}.mlr-coins{gap:4px}.mlr-coins button{width:43px;height:43px;flex-basis:43px}.mlr-coins .clear{width:56px;flex-basis:56px}}

@media screen and (max-width:768px) and (orientation:landscape){
  .mlr-page{
    display:none;
  }

  body::before{
    content:"Please rotate your device to portrait mode";
    position:fixed;
    inset:0;
    display:flex;
    align-items:center;
    justify-content:center;
    background:#000;
    color:#fff;
    font-size:22px;
    z-index:99999;
    text-align:center;
    padding:20px;
  }
}

.mlr-betting-grid{
  position:absolute;
  left:18px;
  right:18px;
  bottom:10px;
  height:148px;
  z-index:30;
  display:grid;
  grid-template-columns:repeat(4,1fr);
  grid-template-rows:repeat(2,1fr);
  border:1px solid #ff4dff;
  border-radius:18px;
  overflow:hidden;
  background:rgba(0,0,0,.15);
  box-shadow:0 0 12px #ff4dff;
}

.mlr-bet-cell{
  position:relative;
  border-right:1px solid rgba(255,77,255,.75);
  border-bottom:1px solid rgba(255,77,255,.75);
  background:transparent;
  overflow:hidden;
}

.mlr-bet-cell:nth-child(4n){
  border-right:0;
}

.mlr-bet-cell:nth-child(n+5){
  border-bottom:0;
}

.mlr-bet-logo{
  position:absolute;
  top:6px;
  left:50%;
  width:34px;
  height:34px;
  transform:translateX(-50%);
  object-fit:contain;
  filter:drop-shadow(0 5px 6px #000);
}

.mlr-bet-cell span,
.mlr-rupee{
  position:absolute;
  left:0;
  right:0;
  bottom:9px;
  color:#ffe829;
  text-align:center;
  font-size:16px;
  font-weight:1000;
}

@media(max-width:390px){
  .mlr-betting-grid{
    left:18px;
    right:18px;
    bottom:10px;
    height:148px;
  }

  .mlr-bet-logo{
    top:10px;
    width:34px;
    height:34px;
  }
}

/* override spacing */
.mlr-page{
  padding:0 10px 18px !important;
}

.mlr-results{
  margin:0 !important;
  border-radius:0 !important;
}

.mlr-board{
  margin-top:0 !important;
}

@media(max-width:390px){
  .mlr-page{
    padding:0 8px 14px !important;
  }

  .mlr-results{
    margin:0 !important;
  }
}

html,body,#root{
  margin:0 !important;
  padding:0 !important;
  width:100% !important;
  height:auto !important;
  min-height:0 !important;
  overflow-x:hidden !important;
  background:#020006 !important;
}

body{
  overflow-y:auto !important;
}

.mlr-page{
  min-height:0 !important;
  height:auto !important;
  overflow:hidden !important;
  padding-bottom:0 !important;
  background:#020006 !important;
}

.mlr-board{
  margin-bottom:0 !important;
}

.mlr-coins{
  margin-bottom:0 !important;
}
@media(max-width:390px){
  .mlr-center-dashboard{
    top:222px;
    width:55%;
  }

  .mlr-progress-wrap{
    margin:14px 8px 0;
  }
}
.mlr-round-id{
  top:-100px !important;
}
.mlr-time-left{
  display:none !important;
}

.mlr-user-pill{
display:flex;
align-items:center;
gap:8px;
}

.uml-menu-btn{
width:32px;
height:32px;
display:flex;
align-items:center;
justify-content:center;
padding:0;
line-height:1;
flex-shrink:0;
}

/* =========================================================
   RESPONSIVE RACE BOARD
   Keep the table, track logos and progress bar in one scale.
   The original mobile design was created around a 400x665
   board, so every internal position now follows that ratio.
   ========================================================= */

.mlr-board{
  width:100% !important;
  max-width:480px;
  height:auto !important;
  aspect-ratio:400 / 665;
  container-type:inline-size;
  margin-left:auto;
  margin-right:auto;
  overflow:hidden;
}

.mlr-center-dashboard{
  left:50% !important;
  top:38.35% !important;
  width:75% !important;
  transform:translateX(-50%) !important;
}

/* Scale the complete centre table from the board width, not from the phone
   viewport. 1cqw is always 1% of .mlr-board on every Android device. */
.mlr-dashboard-panel{
  min-height:0 !important;
  height:34cqw !important;
  padding:4.5cqw 2.5cqw 2.5cqw !important;
  border-radius:6cqw !important;
}

.mlr-round-id{
  top:-4.5cqw !important;
  min-width:42.5cqw !important;
  padding:1cqw 2.5cqw !important;
  font-size:2.75cqw !important;
}

.mlr-dash-main{
  height:13.5cqw !important;
  border-radius:3.5cqw !important;
}

.mlr-dash-box{padding:0 3cqw !important;}
.mlr-dash-box small{font-size:3cqw !important;}
.mlr-dash-box b{
  margin-top:1cqw !important;
  font-size:4.75cqw !important;
}

.mlr-progress-wrap{
  width:calc(100% - 4cqw) !important;
  height:5cqw !important;
  margin:2.5cqw 2cqw 0 !important;
  overflow:hidden;
}

.mlr-progress-fill{
  height:100%;
}

.mlr-progress-car{
  top:-2.5cqw !important;
  font-size:5.25cqw !important;
}

.mlr-finish{
  right:0 !important;
  top:-2.25cqw !important;
  font-size:6.25cqw !important;
}

.mlr-track-area{
  left:0 !important;
  right:0 !important;
  top:1.2% !important;
  width:100% !important;
  height:70.68% !important;
}

.mlr-track-logo{
  width:10.25cqw !important;
  height:10.25cqw !important;
  min-width:0 !important;
  min-height:0 !important;
  border-width:clamp(1px,.5vw,2px);
}

.mlr-track-logo img{
  width:100% !important;
  height:100% !important;
  object-fit:cover;
}

.mlr-moving-marker{
  width:15cqw !important;
  height:15cqw !important;
  border-width:clamp(3px,1.2vw,5px);
}

.mlr-moving-marker img{
  width:12.5cqw !important;
  height:12.5cqw !important;
  object-fit:cover;
}

@media(max-width:390px){
  .mlr-board{
    height:auto !important;
  }

  .mlr-center-dashboard{
    top:38.35% !important;
    width:75% !important;
  }

  .mlr-track-area{
    top:1.2% !important;
    height:70.68% !important;
  }

  .mlr-track-logo{
    width:10.25cqw !important;
    height:10.25cqw !important;
  }

  .mlr-moving-marker{
    width:15cqw !important;
    height:15cqw !important;
  }
}

/* Final native safe-area override (must remain last in this file). */
.mlr-page{
  padding-top:max(24px,env(safe-area-inset-top,0px)) !important;
}